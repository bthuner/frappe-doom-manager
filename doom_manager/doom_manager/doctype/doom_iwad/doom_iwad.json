{
 "doctype": "DocType",
 "name": "Doom Iwad",
 "module": "Doom Manager",
 "istable": 0,
 "is_submittable": 0,
 "custom": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "hash",
 "title_field": "iwad_title",
 "fields": [
  {
   "fieldname": "iwad_title",
   "label": "Title",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "player",
   "label": "Player",
   "fieldtype": "Link",
   "options": "User",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Owner of this IWAD. Empty means it is a global one, provided by an administrator."
  },
  {
   "fieldname": "wad_file",
   "label": "WAD File",
   "fieldtype": "Attach",
   "reqd": 1
  },
  {
   "fieldname": "is_default",
   "label": "Default",
   "fieldtype": "Check",
   "in_list_view": 1,
   "description": "Served to guests and to players who have not chosen one. Only a free IWAD may be the default."
  },
  {
   "fieldname": "detected_section",
   "label": "Detected",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "file_name",
   "label": "File Name",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "file_size",
   "label": "Size (bytes)",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "detected_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "is_free",
   "label": "Freely Redistributable",
   "fieldtype": "Check",
   "read_only": 1,
   "description": "Set when the file's hash matches a known free IWAD. Only these may be shared with everyone."
  },
  {
   "fieldname": "sha256",
   "label": "SHA-256",
   "fieldtype": "Data",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1
  }
 ]
}
